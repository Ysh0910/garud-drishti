# ============================================================
# GARUD DRISHTI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=8000

# --- Database ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://netra:netra_pass@localhost:5432/netra_gis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins.
# Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- ML Adapter ---
# URL of Tejasvi's Python inference service (Option A).
# Leave empty to use mock adapter (pre-computed grid / mock values).
ML_ADAPTER_URL=

# --- Notifications ---
# Set to "mock" in all non-production environments.
# Real SMS must never fire from development.
SMS_MODE=mock

# --- Object Storage ---
# S3-compatible endpoint for citizen media uploads.
# Leave empty to use local filesystem mock in development.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=garud-drishti-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Auth (Phase 13+) ---
# JWT secret — required before auth endpoints are activated.
JWT_SECRET=
JWT_EXPIRES_IN=24h
